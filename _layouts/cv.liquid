---
layout: default
---
{% unless site.data.resume %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">
        {% if page.cv_pdf %}
          <object
            {% if page.cv_pdf contains '://' %}
              data="{{ page.cv_pdf }}"
            {% else %}
              data="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
            {% endif %}
            width="1000"
            height="1000"
            type='application/pdf'
          />
          </object>
        {% endif %}
      </h1>
    </header>
  </div>
{% endunless %}